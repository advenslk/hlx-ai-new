# ==============================================================
# HELZERX AI SUPPORT - PRODUCTION CONFIGURATION
# ==============================================================

# --------------------------------------------------------------
# DISCORD BOT CREDENTIALS
# --------------------------------------------------------------
# Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# Target Discord Guild (Server) ID for slash command synchronization
DISCORD_GUILD_ID="123456789012345678"

# Category Channel ID where new private tickets will be created
TICKET_CATEGORY_ID="123456789012345679"

# Support & Admin Role IDs (comma-separated IDs)
SUPPORT_ROLE_IDS="123456789012345680,123456789012345681"
ADMIN_ROLE_IDS="123456789012345682"

# Channel ID for ticket transcripts archive and staff audit logs
TRANSCRIPT_CHANNEL_ID="123456789012345683"
STAFF_LOG_CHANNEL_ID="123456789012345684"

# --------------------------------------------------------------
# NVIDIA NIM AI ENGINE CONFIGURATION
# --------------------------------------------------------------
# API Base URL for NVIDIA NIM
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# NVIDIA NIM API Key from https://build.nvidia.com/
NVIDIA_API_KEY="nvapi-your-key-here"

# Model name (e.g., meta/llama-3.1-70b-instruct, meta/llama-3.3-70b-instruct, mistralai/mixtral-8x22b-instruct)
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"

# Maximum context tokens and response tokens
AI_MAX_CONTEXT_TOKENS=8192
AI_MAX_RESPONSE_TOKENS=1024
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3

# Default AI State (enabled/disabled globally)
AI_AUTO_RESPONSE_ENABLED=true

# --------------------------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------------------------
# PostgreSQL connection string:
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL="postgresql+asyncpg://helzerx_user:helzerx_secure_pass@localhost:5432/helzerx_support"

# Synchronous URL for Alembic migrations:
SYNC_DATABASE_URL="postgresql+psycopg2://helzerx_user:helzerx_secure_pass@localhost:5432/helzerx_support"

# SQLite Fallback for local development or testing (leave blank to enforce Postgres)
SQLITE_FALLBACK="true"

# --------------------------------------------------------------
# SECURITY & RATE LIMITING
# --------------------------------------------------------------
# Maximum messages per minute per customer
RATE_LIMIT_PER_MINUTE=6

# Prompt injection filtering sensitivity: HIGH, MEDIUM, LOW
PROMPT_INJECTION_FILTER_LEVEL="HIGH"

# Automatically mask sensitive tokens/passwords in chat transcripts
MASK_SENSITIVE_DATA=true

# --------------------------------------------------------------
# HELZERX BRANDING
# --------------------------------------------------------------
BRAND_NAME="HELZERX"
BRAND_COLOR="#5865F2"
BRAND_SUCCESS_COLOR="#10B981"
BRAND_WARNING_COLOR="#F59E0B"
BRAND_DANGER_COLOR="#EF4444"
BRAND_FOOTER="HELZERX AI Support Engine • Enterprise Tier"
BRAND_LOGO_URL="https://helzerx.com/assets/logo.png"
